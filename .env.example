# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trustcart:trustcart@postgres:5432/trustcart

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Options: "gemini" | "openai"
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash

# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=

# ── Razorpay ─────────────────────────────────────────────────────────────────
# Get test keys at: https://dashboard.razorpay.com/app/keys
# Leave blank to enable automatic mock-mode (checkout still works, no real payment)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Policy Gate ───────────────────────────────────────────────────────────────
# Cumulative discount budget per session (percentage points, not monetary %)
MAX_DISCOUNT_BUDGET_PCT=10.0
# Max number of items the agent may propose in one call
MAX_PROPOSALS_PER_CART=3
# Max discount on any single proposed item
MAX_ITEM_DISCOUNT_PCT=20.0

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
